# Copy to .env and set SECRET_KEY, DATABASE_URL, and LLM_API_KEY for local development.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/next_star_hunter
# Optional log destination; set to a path on a persistent volume in production.
LOG_FILE_PATH=

# Server-side AI API credentials and endpoint. Never expose the key in browser code.
LLM_API_KEY=
LLM_BASE_URL=https://copa.codyssey.kr/v1
LLM_API_STYLE=anthropic
# Proxy model alias; configure this for the selected AI endpoint.
LLM_MODEL=claude-sonnet-4
LLM_TIMEOUT_SECONDS=90
LLM_MAX_COMPLETION_TOKENS=8000
# openai 방식에서만 적용. anthropic 방식은 프롬프트와 서버 검증 사용
LLM_JSON_MODE=false
CHAT_TOTAL_TIMEOUT_SECONDS=105

# 자료 사용 범위: commercial이면 NC 카드 제외
KNOWLEDGE_USAGE_SCOPE=educational_noncommercial
# 운영 HTTPS에서는 true, 로컬 HTTP에서는 false
SESSION_HTTPS_ONLY=false
ENABLE_API_DOCS=false

# Railway 운영 설정은 deploy/railway.env.example 참고 (위 값은 로컬 기본값)
# /data Volume 사용 시 DATABASE_URL=sqlite:////data/app.db
# 공개 HTTPS에서는 SESSION_HTTPS_ONLY=true
# PORT, RAILWAY_VOLUME_MOUNT_PATH는 Railway가 런타임에 주입합니다.
# 실제 SECRET_KEY / LLM_API_KEY를 이 예시 파일에 넣지 마세요.
# Railway의 영속 로그 예시: LOG_FILE_PATH=/data/logs/app.log
